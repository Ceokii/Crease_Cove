---
/**
 * Подвал сайта: служебные страницы и пометка о локальном прототипе.
 */
import { localizedPath, useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const links = [
  { href: localizedPath(locale, 'about/'), label: t.footer.about },
  { href: localizedPath(locale, 'quality/'), label: t.footer.quality },
  { href: localizedPath(locale, 'license/'), label: t.nav.license },
  { href: localizedPath(locale, 'legal/terms/'), label: t.footer.terms },
  { href: localizedPath(locale, 'legal/privacy/'), label: t.footer.privacy },
  { href: localizedPath(locale, 'legal/takedown/'), label: t.footer.takedown },
];
---

<footer class="site-footer">
  <div class="container">
    <nav aria-label={t.a11y.footerNav}>
      <ul class="site-footer__links">
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <p class="site-footer__note" data-prototype-note>{t.footer.prototypeNote}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-12);
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
    padding-block: var(--space-6);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: 0 0 var(--space-4);
    padding: 0;
    list-style: none;
  }

  .site-footer__note {
    margin: 0;
  }
</style>
