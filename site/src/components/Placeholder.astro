---
/**
 * Временная заглушка раздела, который будет сделан на следующих шагах этапа 1.
 * `step` — номер шага из раздела 18.1 ТЗ. Удаляется со страницы,
 * когда раздел реализован.
 */
import { format, useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  step: string;
}

const { locale, step } = Astro.props;
const t = useTranslations(locale);
---

<section class="placeholder" data-placeholder={step}>
  <p class="placeholder__badge">{t.placeholder.badge}</p>
  <p>{t.placeholder.text}</p>
  <p class="placeholder__step">{format(t.placeholder.plannedStep, { step })}</p>
</section>

<style>
  .placeholder {
    padding: var(--space-6);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-note-bg);
    color: var(--color-note-text);
  }

  .placeholder__badge {
    display: inline-block;
    margin-bottom: var(--space-3);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .placeholder__step {
    margin: 0;
    font-size: var(--text-sm);
  }
</style>
